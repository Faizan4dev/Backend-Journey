<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Post</title>
</head>
<body>
    <h2>Edit Post</h2>
    <p>Post ID: <%= post.id %></p>
    <h3>@<%= post.username %></h3>
    <form method="POST" action="/posts/<%= post.id %>?_method=PATCH">
    <textarea name="content" rows="10" cols="50"><%= post.content %></textarea> <br/>
    <button>Submit</button>
    </form>
    <!-- <button><a href="/posts">Back to Posts</a></button> -->
</body>
</html>