<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add new Chat</title>
</head>
<body>
    <h2>Add new Chat</h2>
    <form method="POST" action="/chats">
        <input type="text" name="from" placeholder="Who are you?"/><br/><br/>
        <textarea name="msg" placeholder="Type your message here..."></textarea><br/><br/>
        <input type="text" name="to" placeholder="Who is the recipient?"/><br/><br/>
        <button type="submit">Send Message</button>
    </form>
</body>
</html>