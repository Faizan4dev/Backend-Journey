<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Users Data</title>
    <style>
        tr , th , td {
            border: 1px solid black;
        }
        h1 {
            display: inline-block;
        }
    </style>
</head>
<body>
    <h1>Here's the Users List</h1> 
    <form method="GET" action="/users/newuser" >
        <button>Add New User</button>
    </form> <br/>
    <form method="GET" action="/users/delete" >
        <button>Delete User</button>
    </form>
    <br/>
    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Email</th>
                <th>Action</th>
            </tr>
    
            <%for(user of users){ %>
                <tr>
                    <td><%= user.id %></td>
                    <td><%= user.username %></td>
                    <td><%= user.email %></td>
                    <td>
                        <form method="GET" action="/user/<%= user.id %>/edit" >
                            <button>Edit</button>
                        </form>
                    
                    </td>
                </tr>
            
            <%}%>

        </thead>
        
    </table>
    
</body>
</html>
