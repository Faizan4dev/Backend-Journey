<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>New User</title>
</head>
<body>
    <h1>Add new User</h1>
    <form method="POST" action="/users/newuser/adduser">
        <textarea name="username" placeholder="Enter user name"></textarea> <br/><br/>
        <textarea name="email" placeholder="Enter email"></textarea> <br/><br/>
        <input name="password" placeholder="Enter Password" /> <br/><br/>
        <button>Add user</button>
    </form>
</body>
</html>